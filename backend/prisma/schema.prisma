generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite is the default for local development. Switch to postgresql for production deployments.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  coupleId     Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  couple       Couple?       @relation(fields: [coupleId], references: [id])
  sentInvites  Invitation[]  @relation("InviterInvitations")
  receivedInvites Invitation[] @relation("InviteeInvitations")
}

model Couple {
  id              Int      @id @default(autoincrement())
  name            String
  anniversaryDate DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  members         User[]
  dates           Date[]
}

model Invitation {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  status     String   @default("PENDING")
  inviterId  Int
  inviteeId  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  inviter    User     @relation("InviterInvitations", fields: [inviterId], references: [id])
  invitee    User     @relation("InviteeInvitations", fields: [inviteeId], references: [id])
}

model Date {
  id          Int      @id @default(autoincrement())
  coupleId    Int
  title       String
  scheduledAt DateTime
  details     String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  couple      Couple   @relation(fields: [coupleId], references: [id])

  @@index([coupleId, scheduledAt])
}
